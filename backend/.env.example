# Gemini API key for the agents (default model: gemini-2.5-flash)
GEMINI_API_KEY=...
# Optional override if you want a different Gemini model
# GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis URL for durable plan/trace persistence. Leave unset to use the
# in-memory store (fine for local dev). In Docker Compose this is set to the
# bundled redis service automatically.
# REDIS_URL=redis://localhost:6379/0

# Tavily web-search API key for agent grounding (optional — agents degrade
# gracefully without it). https://tavily.com
TAVILY_API_KEY=tvly-...
