# Anthropic API key for the agents (claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tavily web-search API key for agent grounding (optional — agents degrade
# gracefully without it). https://tavily.com
TAVILY_API_KEY=tvly-...
