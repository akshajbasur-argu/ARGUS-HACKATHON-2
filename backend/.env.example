# Gemini API key for the agents (default model: gemini-2.5-flash).
# REQUIRED: the agents make live Gemini calls (web-grounded research via the
# native google_search tool + reasoning) with no offline fallback. The server
# fails fast at boot if this is unset. Web grounding also requires internet.
GEMINI_API_KEY=...
# Optional override if you want a different Gemini model
# GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis URL for durable plan/trace persistence. Leave unset to use the
# in-memory store (fine for local dev). In Docker Compose this is set to the
# bundled redis service automatically.
# REDIS_URL=redis://localhost:6379/0
